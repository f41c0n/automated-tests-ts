{
  "name": "cucumber-poc",
  "version": "1.0.0",
  "description": "WebdriverIO + Cucumber E2E POC in TypeScript",
  "main": "index.js",
  "keywords": [
    "cucumber",
    "e2e",
    "webdriverio",
    "gherkin",
    "bdd",
    "typescript"
  ],
  "author": "Marcin Zietara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/f41c0n/automated-tests-ts.git"
  },
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "posttest": "allure generate ../../reports/e2e/cucumber/allure-results --clean -o ../../reports/e2e/cucumber/allure-report && allure open ../../reports/e2e/cucumber/allure-report"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@wdio/allure-reporter": "^9.30.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/cucumber-framework": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "allure-commandline": "^2.43.0",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "webdriverio": "^9.30.1"
  }
}
